  "outcomes": [
    {
      "description": "Evaluate long-term safety and tolerability of pelacarsen (TQJ230) in participants with elevated Lp(a) and established atherosclerotic cardiovascular disease who have completed the parent study",
      "measure": "Incidence of Adverse events (AEs) or serious adverse events (SAEs)",
      "outcome_type": "primary",
      "time_frame": "Up to 48 months"
    },
    {
      "description": "Evaluate the long-term efficacy of pelacarsen (TQJ230) in lowering Lp(a) levels",
      "measure": "Observed value and change in Lipoprotein(a) (Lp(a)) compared to baseline of the parent study",
      "outcome_type": "secondary",
      "time_frame": "Baseline of the core study, Month 3, 12, 24, 36, 48"
    },
    {
      "description": "Evaluate the long-term efficacy of pelacarsen (TQJ230) in lowering Lp(a) levels",
      "measure": "Observed value and change in Lp(a) compared to baseline of the rollover extension program (REP) study",
      "outcome_type": "secondary",
      "time_frame": "Baseline of the REP study, Month 3, 12, 24, 36, 48"
    }
  ],
