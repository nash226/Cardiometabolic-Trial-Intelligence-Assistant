  "outcomes": [
    {
      "description": "Time averaged change from baseline in log Lp(a) measured between Day 60 and Day 180, defined as the area under the curve (AUC) between the Day 60 Visit date and the Day 180 Visit date, divided by the duration between the two visit dates.",
      "measure": "Time averaged percentage change from baseline between Day 60 and Day 180",
      "outcome_type": "primary",
      "time_frame": "baseline to day 60 and day 180"
    },
    {
      "description": "Time averaged change from baseline in log Lp(a) measured between Day 60 and Day 360, defined as the area under the curve (AUC) between the Day 60 visit date and the Day 360 visit date, divided by the duration between the two visit dates.",
      "measure": "Difference between DII235 dose 2 and placebo in time-averaged percent change from baseline in Lp(a) measured between Day 60 and Day 360",
      "outcome_type": "primary",
      "time_frame": "baseline to day 60 and day 360"
    },
    {
      "description": "Time averaged change from baseline in log Lp(a) measured between Day 60 and Day 360, defined as the area under the curve (AUC) between the Day 60 visit date and the Day 360 visit date, divided by the duration between the two visit dates.",
      "measure": "Difference between DII235 dose 4 and placebo in time-averaged percent change from baseline in Lp(a) measured between Day 60 and Day 360",
      "outcome_type": "primary",
      "time_frame": "baseline to day 60 and day 360"
    },
    {
      "description": "Time averaged change from baseline in log Lp(a) measured between Day 60 and Day 360, defined as the area under the curve (AUC) between the Day 60 visit date and the Day 360 visit date, divided by the duration between the two visit dates.",
      "measure": "Difference between DII235 dose 1, dose 3 and placebo versus placebo in time-averaged percent change from baseline in Lp(a) measured between Day 60 and Day 360",
      "outcome_type": "secondary",
      "time_frame": "baseline to day 60 and 360"
    },
    {
      "description": "Time averaged change from baseline in log Lp(a) measured between Day 240 and Day 360, defined as the area under the curve (AUC) between the Day 240 Visit date and the Day 360 Visit date, divided by the duration between the two visit dates.",
      "measure": "Difference between DII235 doses versus placebo in time-averaged percent change from baseline in Lp(a) measured between Day 240 and Day 360",
      "outcome_type": "secondary",
      "time_frame": "baseline to day 240 and Day 360"
    },
    {
      "description": "Participant's status of achieving Lp(a) \\< 125 nmol/L at Day 180 and at Day 360 (Yes, No), without having any defined intercurrent events.",
      "measure": "Difference between DII235 doses versus placebo with respect to the proportion of participants in achieving Lp(a) < 125 nmol/L at Day 180 and Day 360",
      "outcome_type": "secondary",
      "time_frame": "Day 180 and Day 360"
    },
    {
      "description": "Participant's status of achieving Lp(a) \\< 75 nmol/L at Day 180 and at Day 360 (Yes, No), without having any defined intercurrent events.",
      "measure": "Difference between DII235 doses versus placebo with respect to the proportion of participants in achieving Lp(a) < 75 nmol/L at Day 180 and Day 360",
      "outcome_type": "secondary",
      "time_frame": "Day 180 and Day 360"
    }
