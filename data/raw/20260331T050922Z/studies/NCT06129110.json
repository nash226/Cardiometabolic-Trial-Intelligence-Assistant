    "outcomesModule": {
      "primaryOutcomes": [
        {
          "description": "Participants will undergo a standard 3-hour hyperinsulinemic/euglycemic clamp with insulin infused at 80 mU/m2/min, and glucose clamped at 90 mg/dl with a variable dextrose infusion.",
          "measure": "Insulin Sensitivity",
          "timeFrame": "12 weeks"
        },
        {
          "description": "Participant weight will be measured using BodyTrace scales during the 12 week intervention.",
          "measure": "Body Weight",
          "timeFrame": "12 weeks"
        },
        {
          "description": "A multi-slice MRI will be used to quantify IMAT and muscle content in both legs with acquisition of \\~20 axial images (10 mm thickness) with 10 mm spacing between images starting superior to the patella. IMAT content will be quantified using the well-validated Sirlin 6-echo method and normalized to muscle volume.",
          "measure": "IMAT Content",
          "timeFrame": "12 weeks"
        },
        {
          "description": "A multi-slice MRI will be used to quantify IMAT and muscle content in both legs with acquisition of \\~20 axial images (10 mm thickness) with 10 mm spacing between images starting superior to the patella. Muscle volume will be quantified using standard methods with anatomical cross-sectional area evaluated in each T1 weighted, high resolution, gradient echo profile scan, and multiplied by the length of the muscle.",
          "measure": "Muscle Mass",
          "timeFrame": "12 weeks"
        },
        {
          "description": "Participants will perform quadriceps muscle strength testing using an isokinetic dynamometer.",
          "measure": "Muscle Strength",
          "timeFrame": "12 weeks"
        }
      ]
    },
