    "descriptionModule": {
      "briefSummary": "The purpose of this study is to see how well LY3938577 works and how safe it is compared to degludec in people with type 2 diabetes. Participation in the study will last about 26 weeks."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
