    "descriptionModule": {
      "briefSummary": "The primary objective of this study is to demonstrate that KAI-9531 subcutaneous (SC) injection once weekly is superior to semaglutide SC once weekly and to placebo SC once weekly on percent change in body weight."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
          "masking": "DOUBLE",
          "maskingDescription": "The participant and investigator will be blinded for participants randomized to KAI-9531 or placebo until the study is complete. Semaglutide will be provided open-label.",
          "whoMasked": [
            "PARTICIPANT",
            "INVESTIGATOR"
          ]
        },
        "primaryPurpose": "TREATMENT"
      },
      "enrollmentInfo": {
