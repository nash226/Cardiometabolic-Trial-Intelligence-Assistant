    "descriptionModule": {
      "briefSummary": "This study is a phase 2 study to Evaluate Efficacy, Safety and Tolerability of HM15211 Treatment for 12 Months in Subjects with Biopsy Confirmed NASH"
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
          "masking": "QUADRUPLE",
