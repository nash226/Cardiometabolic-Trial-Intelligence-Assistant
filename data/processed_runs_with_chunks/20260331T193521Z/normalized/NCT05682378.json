  "outcomes": [
    {
      "description": "Safety and tolerability: TEAEs, TESAEs (incidence, severity, relationship to study drug and discontinuation due to TEAEs)",
      "measure": "Number of participants with treatment-emergent adverse events (TEAEs) and serious adverse events (TESAEs)",
      "outcome_type": "primary",
      "time_frame": "From Day 1 in the study up to the end of study visit; up to 1080 days"
    },
    {
      "description": "Evaluate the long-term effect of inclisiran (from baseline of feeder study to end of study) in lowering LDL-C",
      "measure": "Percentage and absolute change in LDL-C from baseline in the feeder study to end of study",
      "outcome_type": "secondary",
      "time_frame": "Baseline (of feeder study) and Day 1080"
    }
  ],
