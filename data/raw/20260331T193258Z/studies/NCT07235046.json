    "descriptionModule": {
      "briefSummary": "The main purpose of this study is to determine the safety and efficacy of DII235 in adults with elevated lipoprotein(a)."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "maskingInfo": {
          "masking": "DOUBLE",
          "maskingDescription": "In order to preserve the integrity of the study and to minimize bias, a randomized double-blind study design is being used.",
          "whoMasked": [
            "PARTICIPANT",
            "INVESTIGATOR"
          ]
        },
        "primaryPurpose": "TREATMENT"
      },
      "enrollmentInfo": {
        "count": 200,
        "type": "ESTIMATED"
      },
      "phases": [
        "PHASE2"
      ],
      "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\n* Signed informed consent must be obtained prior to participation in the study.\n* Male or female participants 18 to 80 years of age (inclusive) at the screening.\n* Lp(a) \u2265 150 nmol/L at screening, measured at the central laboratory.\n* Participants with evidence of atherosclerotic cardiovascular disease and/or type 2 diabetes mellitus.\n\nExclusion Criteria:\n\n* Severe renal dysfunction\n* Hepatic dysfunction\n* Malignancy within the last 5 years\n* Use of investigational medications as defined in the protocol\n* History or presence at screening of an underlying disease, or surgical, physical, medical, or psychiatric condition that, in the opinion of the Investigator, or sponsor if consulted, would potentially affect participant safety within the study or interfere with participating in or completing the study or with the interpretation of data\n\nOther protocol-defined inclusion/exclusion criteria may apply",
      "healthyVolunteers": false,
      "maximumAge": "80 Years",
      "minimumAge": "18 Years",
      "sex": "ALL",
      "stdAges": [
        "ADULT",
        "OLDER_ADULT"
      ]
    },
    "identificationModule": {
      "briefTitle": "A Study of DII235 in Adults With Elevated Lipoprotein(a)",
      "nctId": "NCT07235046",
      "officialTitle": "A Multi-center, Randomized, Double-blind, Placebo-controlled, Parallel-group, Dose-finding Study to Evaluate Efficacy, Safety, and Tolerability of DII235 in Adults With Elevated Lipoprotein(a)",
      "orgStudyIdInfo": {
        "id": "CDII235A12201"
      },
      "organization": {
        "class": "INDUSTRY",
        "fullName": "Novartis"
      }
    },
    "ipdSharingStatementModule": {
      "description": "Novartis is committed to sharing with qualified external researchers, access to patient-level data and supporting clinical documents from eligible studies. These requests are reviewed and approved by an independent review panel on the basis of scientific merit. All data provided is anonymized to respect the privacy of patients who have participated in the trial in line with applicable laws and regulations.\n\nThis trial data availability is according to the criteria and process described on www.clinicalstudydatarequest.com",
      "ipdSharing": "YES"
    },
