      ],
      "label": "Placebo",
      "type": "PLACEBO_COMPARATOR"
    }
  ],
  "conditions": [
    {
      "is_primary": true,
      "name": "High Risk Cardiovascular Disease",
      "normalized_name": null
    },
    {
      "is_primary": true,
      "name": "Hypertension",
