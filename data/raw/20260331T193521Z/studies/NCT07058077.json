    "descriptionModule": {
      "briefSummary": "This study is designed to learn if enlicitide decanoate is safe and effective to treat children and adolescents with heterozygous familial hypercholesterolemia (HeFH) and high amounts of low-density lipoprotein cholesterol (LDL-C) in the blood.\n\nThe goals of this study are to learn about the safety of enlicitide and if children tolerate it, what happens to enlicitide in a child's body over time, and if enlicitide works to lower cholesterol levels in children more than a placebo."
    },
    "designModule": {
      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "interventionModelDescription": "There are two parts of the study. Part A is a non randomized single treatment group. Part B is randomized parallel treatment groups. Participants who complete either part are then eligible to enroll in an open label extension (single group).",
        "maskingInfo": {
          "masking": "QUADRUPLE",
          "maskingDescription": "Part A and the extension period are open-label. Part B is double-blinded.",
          "whoMasked": [
            "PARTICIPANT",
            "CARE_PROVIDER",
            "INVESTIGATOR",
            "OUTCOMES_ASSESSOR"
          ]
        },
        "primaryPurpose": "TREATMENT"
      },
      "enrollmentInfo": {
        "count": 153,
        "type": "ESTIMATED"
      },
      "phases": [
        "PHASE2",
        "PHASE3"
      ],
      "studyType": "INTERVENTIONAL"
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\nInclusion criteria include, but are not limited to:\n\n* Has possible or definite diagnosis of HeFH based on a locally accepted diagnostic algorithm or diagnosis by genetic testing results\n* Has a fasted LDL-C value (evaluated by the central laboratory) that is \u2265130 mg/dL\n* Is receiving either an optimized daily dose of statin (\u00b1 nonstatin LLT); or a nonstatin LLT with documented intolerance to at least 2 different statins or refusal of statin therapy by the participant or legally acceptable representative\n* Is on a stable dose of all background LLTs for at least 30 days prior to screening, with no medication or dose changes planned during participation in Part A or Part B\n\nExclusion Criteria:\n\nExclusion criteria include, but are not limited to:\n\n* Has a history of homozygous FH based on genetic or clinical criteria, or history of known compound heterozygous FH, or double heterozygous FH\n* Has a history of nephrotic syndrome\n* Has any clinically significant malabsorption condition based on principal investigator assessment\n* Was previously treated/is being treated with certain other cholesterol lowering medications, including proprotein convertase subtilisin/kexin type 9 (PCSK9) inhibitors without adequate washout",
      "healthyVolunteers": false,
      "maximumAge": "17 Years",
      "minimumAge": "6 Years",
      "sex": "ALL",
      "stdAges": [
        "CHILD"
      ]
    },
    "identificationModule": {
      "briefTitle": "A Study of Enlicitide Decanoate (MK-0616, an Oral PCSK9 Inhibitor) in Children and Adolescents With Heterozygous Familial Hypercholesterolemia (MK-0616-029)",
      "nctId": "NCT07058077",
      "officialTitle": "An Operationally Seamless Phase 2/3 Study to Evaluate the Safety, Efficacy, and Pharmacokinetics of Enlicitide Decanoate in Pediatric Participants With Heterozygous Familial Hypercholesterolemia",
