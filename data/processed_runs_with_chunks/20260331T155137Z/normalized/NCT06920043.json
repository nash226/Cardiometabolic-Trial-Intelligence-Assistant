    {
      "description": "To assess the effects of efimosfermin on safety and tolerability.",
      "measure": "Number of participants with treatment emergent adverse events (TEAEs)",
      "outcome_type": "primary",
      "time_frame": "From Day 1 to 100 weeks"
    },
    {
      "description": "To assess the steady-state PK of efimosfermin.",
      "measure": "Serum concentrations of efimosfermin",
      "outcome_type": "secondary",
      "time_frame": "Up to Week 21"
    },
    {
      "description": "To assess the steady-state PK of efimosfermin.",
      "measure": "Maximum serum drug concentration (Cmax) of efimosfermin",
      "outcome_type": "secondary",
      "time_frame": "Up to Week 21"
    },
    {
      "description": "To assess the steady-state PK of efimosfermin.",
      "measure": "Area under the serum concentration-time curve (AUC) of efimosfermin",
      "outcome_type": "secondary",
      "time_frame": "Up to Week 21"
    },
    {
      "description": "To assess the steady-state PK of efimosfermin.",
      "measure": "Average serum drug concentration (Cavg) of efimosfermin",
      "outcome_type": "secondary",
      "time_frame": "Up to Week 21"
    },
    {
      "description": "To assess the steady-state PK of efimosfermin.",
