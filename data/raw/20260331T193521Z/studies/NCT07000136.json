      "designInfo": {
        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "interventionModelDescription": "International, multi-centre, randomised, double-blind, placebo-controlled, parallel-group",
        "maskingInfo": {
          "masking": "TRIPLE",
          "maskingDescription": "Placebo controlled",
          "whoMasked": [
